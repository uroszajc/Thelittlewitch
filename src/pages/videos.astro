---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Videos" description="YouTube videos by Ledonie — readings, horoscopes and spiritual guidance.">
  <section class="page-header">
    <h1>Videos</h1>
    <p class="subtitle">Readings, Horoscopes & Spiritual Guidance</p>
  </section>

  <section class="videos-content">
    <div class="container">
      <p class="intro">
        Catch me on YouTube for live readings, monthly horoscope videos, tarot pulls, 
        and spiritual guidance. Subscribe to stay connected with the cosmos.
      </p>

      <div class="channel-link">
        <a href="https://www.youtube.com/@TheLittleWitch" target="_blank" rel="noopener" class="youtube-btn">
          ▶ Subscribe on YouTube
        </a>
      </div>

      <div class="video-grid">
        <!-- Replace these with actual YouTube video IDs -->
        <div class="video-card">
          <div class="video-embed">
            <iframe 
              src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
              title="May 2026 Horoscope"
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
          <h3>May 2026 Full Horoscope for All Signs</h3>
          <p>A deep dive into what May has in store for each zodiac sign.</p>
        </div>

        <div class="video-card">
          <div class="video-embed">
            <iframe 
              src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
              title="Tarot Tuesday"
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
          <h3>Tarot Tuesday — Weekly Guidance</h3>
          <p>Weekly tarot reading for clarity and direction.</p>
        </div>

        <div class="video-card">
          <div class="video-embed">
            <iframe 
              src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
              title="Live Mediumship"
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
          <h3>Live Mediumship Circle</h3>
          <p>A recording from our most recent group mediumship session.</p>
        </div>
      </div>

      <div class="more-videos">
        <p>More videos uploaded weekly. Subscribe to get notified!</p>
        <a href="https://www.youtube.com/@TheLittleWitch" target="_blank" rel="noopener" class="btn">Visit My YouTube Channel →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.page-header {
  background: linear-gradient(135deg, #4a3562, #2d1f47);
  color: white; text-align: center; padding: 5rem 2rem 3rem;
}
.page-header h1 { font-size: 3.5rem; }
.page-header .subtitle { color: var(--gold); font-style: italic; font-size: 1.1rem; margin-top: 0.5rem; }

.videos-content { padding: 4rem 0; }
.container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
.intro { text-align: center; max-width: 600px; margin: 0 auto 2rem; color: #555; }

.channel-link { text-align: center; margin: 2rem 0 3rem; }
.youtube-btn {
  display: inline-block; padding: 1rem 2.5rem; background: #ff0000; color: white;
  border-radius: 50px; font-weight: 600; font-size: 1rem;
  transition: transform 0.2s, box-shadow 0.2s;
}
.youtube-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255,0,0,0.3); color: white; }

.video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 3rem; }
.video-card { background: white; border-radius: 8px; overflow: hidden; border: 1px solid rgba(201,168,76,0.2); }
.video-embed { position: relative; padding-bottom: 56.25%; height: 0; }
.video-embed iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.video-card h3 { padding: 1.2rem 1.2rem 0.5rem; font-size: 1.1rem; color: var(--deep-purple); }
.video-card p { padding: 0 1.2rem 1.2rem; font-size: 0.88rem; color: #666; }

.more-videos { text-align: center; padding: 2rem; background: var(--cream); border-radius: 8px; }
.more-videos p { margin-bottom: 1rem; color: #555; }
</style>